# ---- Database ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=wa_erp
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# The connection string is stated once; each schema only appends its own suffix.
POSTGRES_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_URL=${POSTGRES_URL}?schema=public
TEST_DATABASE_URL=${POSTGRES_URL}?schema=test

# ---- Authentication ----
JWT_SECRET=change-me-to-at-least-32-characters-long
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# ---- First user (npm run db:seed) ----
OWNER_USERNAME=owner
OWNER_PASSWORD=change-me-on-the-first-login
